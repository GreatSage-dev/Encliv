# ============================================================
# Encliv Environment Variables
# Copy to .env and fill in values — NEVER commit .env
# ============================================================

# Deployer private key for Coston2 (hex, no 0x prefix)
PRIVATE_KEY=

# Coston2 RPC
COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc

# Deployed contract address (filled after deployment)
POLICY_REGISTRY_ADDRESS=

# TEE mode: 0 = GCP Confidential Space (production), 1 = Simulated (development)
TEE_MODE=1

# Governance — threshold set to 2, second signer TBD post-hackathon
GOVERNANCE_SIGNERS=0xYourAddress,0xTBD_SecondSigner
GOVERNANCE_THRESHOLD=2

# Cosigner — designed but not demo'd for hackathon
# COSIGNER_THRESHOLD=2
# LARGE_AMOUNT_THRESHOLD=5000000000000000000

# Coston2 Indexer DB (credentials provided by Flare DevRel)
INDEXER_DB_HOST=
INDEXER_DB_USER=
INDEXER_DB_PASSWORD=
INDEXER_DB_NAME=indexer
